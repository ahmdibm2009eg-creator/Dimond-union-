{
  "name": "Project",
  "type": "object",
  "properties": {
    "name_ar": {
      "type": "string"
    },
    "name_en": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "stands",
        "exhibition",
        "interior",
        "signage"
      ],
      "default": "stands"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name_ar",
    "category"
  ]
}